      "messages": [
        {
          "id": "0bb20155-9cae-4fe8-aff4-862c945df9b5",
          "kind": "date",
          "text": "Thursday, February 12",
          "dateParts": {
            "mode": "calendar",
            "month": 2,
            "day": 12,
            "weekday": 4
          }
        },
        {
          "id": "641ba136-909f-48d9-abf1-66cd6ef2a471",
          "from": "them",
          "text": "hola enzo",
          "time": "12:39"
        },
        {
          "id": "b043f871-fd5c-4dc5-a614-a74bfed74947",
          "from": "me",
          "text": "hola juli",
          "time": "12:39"
        },
        {
          "id": "090ef71c-d0a8-4d16-b1aa-fdfac3e6d7a5",
          "from": "me",
          "text": "dios no lo puedo creer",
          "time": "12:39"
        },
        {
          "id": "b1ce3822-6dcf-4d4e-9948-26d143da5130",
          "from": "me",
          "text": "hola mi amor",
          "time": "12:39"
        },
        {
          "id": "2800962c-a48c-46aa-95d8-0cc104468d8b",
          "from": "me",
          "text": "te extraño te extraño tanto",
          "time": "12:39"
        },
        {
          "id": "ade80cd1-ce8e-47a7-b10a-51741dfd8de2",
          "from": "me",
          "text": "estoy desesperado",
          "time": "12:39"
        },
        {
          "id": "2c80cc77-8d66-40f5-a06b-1c01a0f39f6b",
          "from": "me",
          "text": "tengo tanto miedo te extrañe tanto juli",
          "time": "12:39"
        },
        {
          "id": "671684f3-bf00-4de0-a375-2b9b29807d34",
          "from": "me",
          "text": "por favor hago lo que sea para que vos aunque sea estes conmigo",
          "time": "12:39"
        },
        {
          "id": "ebdabb48-279e-4e11-aadc-515bb5849059",
          "from": "me",
          "text": "lo que vos quieras",
          "time": "12:39"
        },
        {
          "id": "a955acca-a5e4-44ce-8de5-95c21a67168e",
          "from": "me",
          "text": "te juro que te amo julian te amo",
          "time": "12:39"
        },
        {
          "id": "29ab172f-6d4b-4f5b-a8e0-572ae03070e6",
          "from": "them",
          "text": "enzo para dejame terminar de escribir",
          "time": "12:39"
        },
        {
          "id": "975dc7b5-42bd-4398-b758-95627e2945e2",
          "from": "me",
          "text": "no puedo Julian te extraño tanto necesito explicarme con vos por favor julian no me dejes",
          "time": "12:39"
        },
        {
          "id": "b39f6e64-4887-4ef2-a6a3-6405ebaa7e64",
          "from": "me",
          "text": "spy egoista y mala persona pero te amo te lo juro",
          "time": "12:39"
        },
        {
          "id": "c3f78916-48eb-453a-86cc-1c048cc687a0",
          "from": "me",
          "text": "decime que vis tambien lo haces por favor decime que no hay otra persona",
          "time": "12:39"
        }
      ],
