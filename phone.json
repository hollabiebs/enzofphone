        },
        {
          "id": "d773a48b-957d-4f79-b644-1ee35e73bdaf",
          "from": "them",
          "text": "me time un didi",
          "time": "12:39"
        },
        {
          "id": "8c0652b4-7206-4ad6-afcc-7e229b892588",
          "from": "them",
          "text": "respirá ondo por favor",
          "time": "12:39"
        },
        {
          "id": "9251bb3d-938f-4bef-a71c-6089695719c6",
          "from": "them",
          "text": "todo va a estar bien",
          "time": "12:39"
        },
        {
          "id": "69cfa440-69b2-4236-b6d9-e57ba7f28d37",
          "from": "them",
          "text": "vos que opinas?",
