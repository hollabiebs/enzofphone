        },
        {
          "id": "a4bbf6e3-5ff4-4a0b-89e5-a4cc3e530948",
          "from": "me",
          "text": "no paro de llorar y temblar equi sigue escribiendo encima",
          "time": "12:39"
        },
        {
          "id": "4b05b1ea-2ee5-4f9d-b707-70308d8eaedd",
          "from": "me",
          "text": "necesito que vuelva equi",
          "time": "12:39"
        },
        {
          "id": "d5a5cb01-17f8-4002-bfbe-cb45f0bfcc38",
